// =====================================================================
// PRIMA-PM — Prisma Schema
// Integrated Project Management Web Application
// DB: PostgreSQL 16 | Money: Decimal(18,2) | Generated: 2026-06-27
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS
// =====================================================================

enum Role {
  ADMIN
  PMO
  PROJECT_MANAGER
  FINANCE
  RISK_OFFICER
  TEAM_MEMBER
  VIEWER
  // Self-service guest: self-signs up, sees/manages ONLY their own personal projects
  // (Project.personalOwnerId == their id), self-governs them with no approval matrix.
  GUEST
}

// Lifecycle of a pooled-multitenancy organization (see docs/MULTITENANCY-POOLED-PLAN.md).
// SUSPENDED keeps the tenant's data but bars sign-in / API access.
enum TenantStatus {
  ACTIVE
  SUSPENDED
  // Self-serve org signup (option C): a new corporate tenant lands here and is locked out until a
  // platform admin approves (→ ACTIVE) or rejects (→ REJECTED). Its owner cannot log in while PENDING.
  PENDING
  // A rejected self-serve signup — kept (soft) for review/audit, stays locked out. Removed via the
  // platform hard-delete endpoint when no longer needed.
  REJECTED
}

// SaaS subscription tier (Phase 6). Gates per-tenant quotas (projects/members/storage). FREE is the
// default for new + backfilled tenants; ENTERPRISE is unlimited. See lib/tenant/plans.ts for limits.
enum TenantPlan {
  TRIAL
  PRO
  ENTERPRISE
}

enum ProjectStatus {
  DRAFT
  CHARTERED
  IN_PROGRESS
  ON_HOLD
  CLOSED
}

enum ProjectCategory {
  NETWORK_INFRA
  SERVER_INFRA
  CLOUD_INFRA
  CYBERSECURITY_INFRA
  APP_DEV
  DATACENTER
  ENTERPRISE_APP
  SYSTEM_INTEGRATION
  DATA_ANALYTICS
  AI_ML
  DIGITAL_TRANSFORMATION
  MANAGED_SERVICES
  IT_CONSULTING
  OTHER
}

enum ChangeMagnitude {
  MINOR
  MAJOR
}

enum ChangeImpact {
  CHARTER
  COST
  SCHEDULE
  RESOURCE
  QUALITY
  RISK
}

enum DirectCostType {
  TECHNOLOGY_ONPREM
  TECHNOLOGY_CLOUD
  HARDWARE_LICENSE
  SOFTWARE_LICENSE
  MANPOWER
  SUBCONTRACTOR
  TRAINING_CERTIFICATION
  SUPPORT_MAINTENANCE
  HARDWARE_EQUIPMENT
  OTHER
}

enum PersonnelRole {
  PM
  PROJECT_PERSONNEL
}

// Splits an Actual Cost entry into the direct/indirect budget it draws down, so
// "remaining Direct vs Indirect" can be computed (AC is otherwise uncategorised).
// Labour-from-timesheet AC is always DIRECT.
enum CostCategory {
  DIRECT
  INDIRECT
}

enum IndirectCostType {
  TRANSPORTATION
  ACCOMMODATION
  ENTERTAINMENT
  MEALS_PERDIEM
  COMMUNICATION
  OFFICE_SUPPLIES
  MEETING_VENUE
  OTHER
}

enum RiskKind {
  THREAT
  OPPORTUNITY
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  IDENTIFIED
  ANALYZING
  PLANNED
  OPEN
  CLOSED
  OCCURRED
}

enum ResponseStrategy {
  AVOID
  MITIGATE
  TRANSFER
  ACCEPT
  EXPLOIT
  ENHANCE
  SHARE
}

enum DependencyType {
  FS // Finish-to-Start
  SS // Start-to-Start
  FF // Finish-to-Finish
  SF // Start-to-Finish
}

enum ChangeRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// Delivery methodology for a project (predictive/waterfall, agile, or hybrid).
enum DeliveryApproach {
  PREDICTIVE
  AGILE
  HYBRID
}

enum BacklogType {
  EPIC
  STORY
  TASK
  BUG
}

// Board columns for an agile work item.
enum BacklogStatus {
  TODO
  IN_PROGRESS
  DONE
  DEFERRED // consciously descoped at/near closeout — out of scope, not counted as open
}

enum SprintStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum AttachmentOwner {
  CHARTER
  RISK
  PROJECT
  TASK
}

// =====================================================================
// CORE / IDENTITY
// =====================================================================

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  // Nullable: accounts created via Google sign-in (role GUEST) have no local password —
  // they authenticate only through the OAuth provider. Password login rejects a null hash.
  passwordHash String?
  // Google account subject (the stable per-user `sub` claim). Set when a user signs in with
  // Google; unique so an account binds to exactly one Google identity. Null for password users.
  googleSub    String?  @unique
  // Unguessable token for the user's personal iCal calendar feed (T4.2). Null until they enable it;
  // the feed URL embeds it (calendar apps poll the URL unauthenticated, like a Slack webhook URL).
  calendarFeedToken String? @unique
  role         Role     @default(VIEWER)
  // Account TYPE (global identity), distinct from the per-tenant Membership.role: true for a
  // self-service GUEST sandbox account, false for staff. This is what corporate features gate on
  // (messaging, tenant membership, corporate-PM assignment) once the legacy global `User.role` is
  // retired (Phase 4c) — "is a sandbox account" is an identity property, not a per-tenant role.
  isGuest      Boolean  @default(false)
  // PLATFORM (super-admin) privilege — transcends tenants: may create/suspend tenants and provision
  // their first admin via /admin/tenants (Phase 5). Distinct from a per-tenant Membership.role=ADMIN.
  // Granted deliberately (never auto); default false.
  isPlatformAdmin Boolean @default(false)
  // ISO-3166-1 alpha-2 country from Cloudflare's CF-IPCountry header (geo analytics only, not IP).
  // Captured on signup + backfilled on login; null off-Cloudflare (LAN/dev) or unknown.
  country      String?
  isActive     Boolean  @default(true)
  // When the user confirmed ownership of their email (clicked the activation link). NULL = not yet
  // verified. The HARD verification wall (login blocks unverified accounts) is armed only when SMTP
  // email is configured (emailEnabled()); with no mail server accounts are born verified so nobody
  // is ever locked out. Provider sign-ins (Google/Microsoft) are pre-verified. See lib/mailer.ts.
  emailVerifiedAt DateTime?
  // Bumped to revoke every outstanding token for this user (logout, password change/reset,
  // deactivation). Access/refresh tokens embed the tv they were minted at; requireAuth
  // rejects any token whose tv is stale.
  tokenVersion Int      @default(0)
  changesSeenAt DateTime? // last time this user viewed the change-notification feed
  digestFrequency DigestFrequency @default(OFF) // emailed alert digest cadence (opt-in)
  digestLastSentAt DateTime? // scheduler-managed: last time a digest was sent to this user
  dashboardLayout Json?    // per-user desktop dashboard: ordered array of enabled widget keys (null = default)
  dashboardDefaultView String? // default landing view: portfolio | forecast | resources | cards (null = portfolio)
  notificationPrefs Json?  // per-category channel prefs, e.g. { email: { approvals: false } } (null/absent = all on)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // relations
  managedProjects   Project[]       @relation("ProjectManager")
  charters          ProjectCharter[] @relation("CharterPM")
  ownedRisks        Risk[]          @relation("RiskOwner")
  ownedIssues       Issue[]         @relation("IssueOwner")
  ownedAssumptions  Assumption[]        @relation("AssumptionOwner")
  ownedDependencies ProjectDependency[] @relation("DependencyOwner")
  assignedTasks     Task[]          @relation("TaskPIC")
  manpowerItems     CostItemDirect[] @relation("ManpowerResource")
  auditLogs         AuditLog[]
  changeRequests    ChangeRequest[] @relation("CRRequester")
  reviewedCRs       ChangeRequest[] @relation("CRReviewer")
  decidedCRs        ChangeRequest[] @relation("CRDecider")
  resourceProfiles  Resource[]      @relation("ResourceUser")
  assignedBacklog   BacklogItem[]   @relation("BacklogAssignee")
  notifications     Notification[]  @relation("UserNotifications")
  feedbacks         Feedback[]      @relation("UserFeedback")
  alertDismissals   AlertDismissal[] @relation("UserAlertDismissals")
  refreshTokens     RefreshToken[]  @relation("UserRefreshTokens")
  emailTokens       EmailToken[]    @relation("UserEmailTokens")
  sentMessages      Message[]       @relation("MessageSender")
  conversationsA    Conversation[]  @relation("ConvUserA")
  conversationsB    Conversation[]  @relation("ConvUserB")
  conversationMemberships ConversationMember[] @relation("ConvMemberUser")
  messageReactions  MessageReaction[] @relation("ReactionUser")
  pushSubscriptions PushSubscription[]
  memberships       Membership[]

  @@index([role])
}

// =====================================================================
// MULTITENANCY (pooled) — see docs/MULTITENANCY-POOLED-PLAN.md
// Phase 1: additive & non-enforcing. A single "default" Tenant owns all existing
// data and every user gets a Membership carrying their current User.role. No query
// filters anything by tenant yet (that is Phase 3), so behaviour is unchanged.
// =====================================================================

// An organization: the isolation boundary for pooled multitenancy. `slug` is the immutable
// machine key (future subdomain/host mapping, backfill anchor); `name` is the human label.
model Tenant {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  // SaaS plan (Phase 6) — gates per-tenant quotas (projects/members/storage) + feature capabilities.
  // Default TRIAL: a new corporate workspace gets the full PRO experience for `trialEndsAt` days.
  plan      TenantPlan   @default(TRIAL)
  // Trial expiry (null = not on a trial / a paid tenant). An expired trial (now >= trialEndsAt) — or a
  // lapsed subscription (plan=TRIAL, trialEndsAt null/past) — hits the upgrade wall. See
  // docs/SUBSCRIPTION-PLANS-PLAN.md. Personal (guest) tenants are exempt from plan gating.
  trialEndsAt DateTime?
  // Optional vanity/custom domain (Phase 6) — e.g. "pm.acmecorp.com" maps this host to the tenant.
  // The tenant `slug` already gives a subdomain (acme.<APP_BASE_DOMAIN>); this is for a fully custom
  // host. Unique across tenants; null = no custom domain. Stored lowercased.
  customDomain String?    @unique
  // A PERSONAL tenant is a single guest's private sandbox (one per GUEST user), the tenant-native
  // replacement for the legacy `personalOwnerId` isolation (Phase 5 / de-scatter). Corporate
  // tenants are false. Used to exclude personal tenants from the corporate EVM cron fan-out and,
  // later, from super-admin/tenant listings.
  isPersonal Boolean     @default(false)
  // Lemon Squeezy billing (self-serve upgrade). All nullable — a FREE tenant that never paid
  // has none of these. `lsSubscriptionId` is the handle used for the customer portal and for
  // webhook idempotency. `endsAt` is set when a subscription is cancelled but still in its paid
  // period (access continues until then); an `expired` webhook then downgrades to FREE.
  lsSubscriptionId   String?   @unique
  lsCustomerId       String?
  lsVariantId        String?
  subscriptionStatus String?
  renewsAt           DateTime?
  endsAt             DateTime?
  // AI Status Narrative (first Claude-powered feature) — per-tenant opt-in. The feature is also
  // gated globally by ANTHROPIC_API_KEY (aiEnabled() reads process.env live). Both must be true:
  // env unset ⇒ 503; tenant not opted in ⇒ 403. Default off so metrics are only sent to the LLM
  // provider when a tenant explicitly enables it.
  aiNarrativeEnabled Boolean   @default(false)
  // Stage C — semi-autonomous AI actions. A SEPARATE, stronger opt-in than aiNarrativeEnabled:
  // it lets the AI PROPOSE concrete writes (create risk, update task progress, draft CR, tidy
  // schedule) that a human must approve before they execute. Default off even when narrative AI is
  // on, so a tenant explicitly consents to AI-drafted change actions. Still env-gated too.
  aiActionsEnabled Boolean   @default(false)
  // Proactive AI — a SEPARATE, stronger opt-in still: it lets a scheduled weekly sweep auto-DRAFT a
  // status narrative + predictive flags for every active project (spending on the AI provider with
  // no human click), landing them as PENDING briefings a PM reviews. Default off even when narrative
  // AI is on, so a tenant explicitly consents to unattended AI spend. Env-gated too.
  aiProactiveEnabled Boolean @default(false)
  // Cross-session AI memory — lets Anett remember durable facts/preferences (per-user) and
  // org-shared facts/glossary/feedback-corrections (per-tenant) across sessions, injected into its
  // prompt. A SEPARATE opt-in: default off even when narrative AI is on. See docs/AI-MEMORY-FEEDBACK-PLAN.md.
  aiMemoryEnabled Boolean @default(false)
  // Server-side voice (OpenAI Whisper STT + ElevenLabs TTS) — a SEPARATE opt-in; when off (or the
  // provider keys aren't set) Anett falls back to the browser Web Speech API. See docs/AI-VOICE-SERVER-PLAN.md.
  aiVoiceEnabled Boolean @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships Membership[]
  aiBriefings AiBriefing[]
  aiMemories AiMemory[]
  aiFeedbacks AiFeedback[]
  billingEvents  BillingEvent[]
  apiKeys  ApiKey[]
  webhookSubscriptions  WebhookSubscription[]
  webhookDeliveries  WebhookDelivery[]
  automationRules  AutomationRule[]
  projects  Project[]
  projectBookmarks  ProjectBookmark[]
  rateCards  RateCard[]
  resources  Resource[]
  auditLogs  AuditLog[]
  notifications  Notification[]
  feedbacks  Feedback[]
  conversations  Conversation[]
  conversationMembers  ConversationMember[]
  messages  Message[]
  pushSubscriptions  PushSubscription[]
  messageReactions  MessageReaction[]
  appSettings  AppSetting[]
  projectCharters  ProjectCharter[]
  charterVersions  CharterVersion[]
  baselineVersions BaselineVersion[]
  costItemDirects  CostItemDirect[]
  costItemIndirects  CostItemIndirect[]
  costBaselines  CostBaseline[]
  actualCostEntrys  ActualCostEntry[]
  mandayEntrys  MandayEntry[]
  risks  Risk[]
  issues  Issue[]
  stakeholders  Stakeholder[]
  procurements  Procurement[]
  assumptions  Assumption[]
  projectDependencys  ProjectDependency[]
  tasks  Task[]
  taskSteps  TaskStep[]
  taskDependencys  TaskDependency[]
  scheduleUndos  ScheduleUndo[]
  changeRequests  ChangeRequest[]
  attachments  Attachment[]
  sprints  Sprint[]
  sprintSnapshots  SprintSnapshot[]
  evmSnapshots  EvmSnapshot[]
  backlogItems  BacklogItem[]
  lessonLearneds  LessonLearned[]
  acceptanceSignoffs  AcceptanceSignoff[]
  uatTestCases  UatTestCase[]
  kickoffMeetings  KickoffMeeting[]
  kickoffAttendees  KickoffAttendee[]
  kickoffActionItems  KickoffActionItem[]
  requirements  Requirement[]
  requirementTaskLinks  RequirementTaskLink[]
  projectCommentaries  ProjectCommentary[]
  approvalWorkflows  ApprovalWorkflow[]
  approvalRequests  ApprovalRequest[]
  approvalDelegations  ApprovalDelegation[]
  aiActionProposals  AiActionProposal[]
  aiActionOutcomes   AiActionOutcome[]
}

// Append-only audit trail of Lemon Squeezy billing webhooks (what event flipped which plan).
// Written from the webhook handler under the target tenant's context. Not tenant-scoped in
// scopedModels — reads are platform-admin only; writes are stamped with tenantId explicitly.
model BillingEvent {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventName   String
  planBefore  TenantPlan?
  planAfter   TenantPlan?
  rawPayload  Json
  createdAt   DateTime    @default(now())

  @@index([tenantId])
}

// A user's membership in a tenant, carrying their per-tenant role. Identity (`User`) stays
// global (email unique across the whole system) so one person can belong to several tenants
// (PMO/consultants). This per-tenant role supersedes the global `User.role` in Phase 4; both
// are kept (dual-read) until then.
model Membership {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// One row per issued refresh token (id = the token's jti). Refresh tokens ROTATE:
// each /auth/refresh revokes the presented token and mints a new one. Replaying an
// already-revoked token signals theft, so the whole session family is revoked.
model RefreshToken {
  id           String    @id @default(uuid()) // jti embedded in the signed refresh token
  userId       String
  user         User      @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime  // mirrors the JWT exp; expired rows are prunable
  revokedAt    DateTime? // set when rotated away or explicitly revoked (logout/pw-change)
  replacedById String?   // the jti this token was rotated into (audit chain)
  createdAt    DateTime  @default(now())

  @@index([userId])
}

// What a one-time email token authorizes. Kept an enum so future flows (e.g. password reset) slot in.
enum EmailTokenPurpose {
  VERIFY_EMAIL   // confirm email ownership → activate the account (sets User.emailVerifiedAt)
  PASSWORD_RESET // self-service password reset (sets a new passwordHash + revokes all sessions)
}

// How often a user receives the emailed alert digest (overdue / due-soon / risk / budget across
// their projects). OFF = never (the default — opt-in). Guests never receive a digest regardless.
enum DigestFrequency {
  OFF
  DAILY
  WEEKLY
}

// Single-use, expiring token backing email flows (activation). Only the SHA-256 HASH of the random
// token is stored — the raw token lives solely in the emailed link — so a DB leak can't be replayed.
// Consumed (consumedAt set) or expired rows are inert; a fresh request just creates a new row.
model EmailToken {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation("UserEmailTokens", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String            @unique // sha256(raw token), hex
  purpose    EmailTokenPurpose @default(VERIFY_EMAIL)
  expiresAt  DateTime
  consumedAt DateTime? // set the moment the token is redeemed (single-use)
  createdAt  DateTime          @default(now())

  @@index([userId])
}

// Platform-level denylist for self-service sign-up (guest + Google + org). Deleting a guest only
// removes their data — open Google/guest sign-up would let them re-register — so an admin may also
// BLOCK the identity here. Checked (fail-closed) before any account is created/matched on the public
// auth paths. Matches on email OR googleSub. Global model (NOT tenant-scoped): it gates the
// context-less public auth routes, like User/Tenant. Email is always stored lowercase.
model BlockedIdentity {
  id          String   @id @default(uuid())
  email       String?  @unique
  googleSub   String?  @unique
  reason      String?
  createdById String? // the platform admin who blocked it (no FK: survives that admin's deletion)
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([googleSub])
}

// A per-tenant API key for the public REST API (T3). The plaintext secret (pk_live_<random>) is
// shown ONCE at creation and never stored — only its SHA-256 (`hashedKey`). A request presenting
// `Authorization: Bearer pk_...` authenticates as a synthetic principal with this key's `role`
// inside its tenant (RBAC reuses req.user.role); the tenant-scope extension then isolates it.
// Tenant-scoped (in SCOPED_MODELS) so admin list/create/revoke auto-scope; the auth-time lookup by
// hashedKey runs via runAsSystem (no tenant context yet — the key is what selects the tenant).
model ApiKey {
  id          String    @id @default(uuid())
  // Nullable + nullable relation to match the other scoped models (Phase 2a): the tenant-scope
  // extension stamps tenantId on create at runtime, so app code never sets it explicitly.
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  // Display prefix (e.g. "pk_live_a1b2c3") shown in the UI to identify a key without revealing it.
  prefix      String
  // SHA-256 of the full secret; unique so a presented key resolves to exactly one row.
  hashedKey   String    @unique
  // The principal role this key acts as within its tenant. Default VIEWER (read-only) — least privilege.
  role        Role      @default(VIEWER)
  createdById String? // the admin who created it (no FK: survives that user's deletion)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

// An outbound webhook endpoint for the public API (T3.3). When a subscribed event fires in the
// tenant, we POST the event payload here, HMAC-signed with `secret` (the receiver verifies it).
// `events` lists the event names to deliver ('*' = all). Tenant-scoped (in SCOPED_MODELS).
model WebhookSubscription {
  id          String    @id @default(uuid())
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url         String
  events      String[] // event names to deliver; ['*'] = everything
  // Payload shape: GENERIC = signed JSON envelope (verify with the secret); SLACK/TEAMS = a plain
  // { text } chat message posted to that platform's incoming-webhook URL (the URL is the secret).
  format      WebhookFormat @default(GENERIC)
  // Shared signing secret (whsec_...). Shown to the admin once at creation; stored to sign deliveries.
  secret      String
  active      Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())

  deliveries  WebhookDelivery[]

  @@index([tenantId])
}

// One delivery attempt-record per (event, subscription): the payload, its status, and retry state.
// Doubles as the delivery LOG the UI shows and the RETRY QUEUE the background sweep drains.
model WebhookDelivery {
  id             String                @id @default(uuid())
  tenantId       String?
  tenant         Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   WebhookSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?
  error          String?
  nextAttemptAt  DateTime              @default(now())
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())

  @@index([tenantId])
  @@index([status, nextAttemptAt])
  @@index([subscriptionId])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

// Delivery payload shape for a webhook subscription (T4.1).
enum WebhookFormat {
  GENERIC
  SLACK
  TEAMS
}

// A no-code automation rule: when `event` fires in the tenant (and an optional field condition
// matches), run `actionType`. MVP action = NOTIFY (in-app notification to the project PM and/or a
// role). Rides the same domain-event bus as webhooks. Tenant-scoped (in SCOPED_MODELS).
model AutomationRule {
  id              String   @id @default(uuid())
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  event           String   // one of the domain event names (see WEBHOOK_EVENTS)
  // Optional condition: deliver only when payload[conditionField] === conditionEquals (string match).
  conditionField  String?
  conditionEquals String?
  actionType      String   @default("NOTIFY") // MVP: NOTIFY only
  notifyPm        Boolean  @default(false)    // notify the affected project's PM
  notifyRole      Role?                        // notify every member holding this role
  messageTemplate String?  // optional custom notification title
  active          Boolean  @default(true)
  createdById     String?
  createdAt       DateTime @default(now())

  @@index([tenantId])
}

// =====================================================================
// PROJECT + CHARTER (Module 1)
// =====================================================================

model Project {
  id        String        @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  // Project code is unique PER TENANT (Phase 3c): two orgs can each have PRJ-2026-0001. The
  // extension scopes all reads to the tenant; the clash-checks use findFirst (see projects.service).
  code      String
  name      String
  clientName String?      // the client/customer the project is delivered for
  sponsor   String?
  category        ProjectCategory?
  categoryOther   String?  // free-text detail, required only when category = OTHER
  costBaselineIdr Decimal? @db.Decimal(18, 2) // high-level planning cost baseline
  totalRevenueIdr Decimal? @db.Decimal(18, 2) // expected total revenue
  status    ProjectStatus @default(DRAFT)
  deliveryApproach DeliveryApproach @default(PREDICTIVE)
  // Story-point → effort conversion for agile capacity: man-days a resource is loaded per
  // assigned story point (spread over the item's sprint). Tune to the team's point scale.
  mandaysPerPoint Decimal @default(1) @db.Decimal(6, 2)
  pmUserId  String?
  pm        User?         @relation("ProjectManager", fields: [pmUserId], references: [id])
  // (A guest's project is a PERSONAL sandbox — self-governed with no approval matrix. This is now
  // driven entirely by the guest's PERSONAL TENANT, not a per-project flag. The old
  // `personalOwnerId` column was dropped in Phase 5 / de-scatter.)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  // Archived = hidden from the corporate list, dashboard and portfolio roll-ups but NOT deleted:
  // it lives in the ADMIN/PMO "Project Database" Archive tab and can be restored. Distinct from
  // deletedAt (a real soft-delete). NULL = a live project.
  archivedAt   DateTime?
  archivedById String?
  scheduleBaselinedAt DateTime? // when the schedule baseline was last captured
  closedAt    DateTime?    // when the project moved to CLOSED
  closedById  String?      // actor who closed it (plain id, no FK — kept light)
  closureNote String?      // closure summary, or the mandatory reason for a force-close
  onHoldReason String?     // why the project is currently ON_HOLD (cleared on resume)
  // When set, the cost/schedule baseline (PMB/BAC) is frozen: cost lines, management
  // reserve, WBS tasks and the schedule baseline cannot be changed. Progress/actuals and
  // the risk register stay editable. ADMIN/PMO unlock (with a reason) to make baseline changes.
  baselineLockedAt   DateTime?
  baselineLockedById String?
  // Stamped once when the project first becomes activation-ready (all baselines set) and
  // ADMIN/PMO have been notified — so the "ready to activate" alert fires only once.
  activationReadyNotifiedAt DateTime?
  // PMO activation-review outcome. NULL = in the activation queue (awaiting review or approved
  // via activation). NEEDS_REVISION / REJECTED = sent back to the PM with a note; the project
  // leaves the PMO queue until the PM resubmits (clears these back to NULL). History = AuditLog.
  activationReviewStatus String?   // null | 'NEEDS_REVISION' | 'REJECTED'
  activationReviewNote   String?   // the PMO's reason, shown to the PM
  activationReviewAt     DateTime?
  activationReviewById   String?
  // When true, logging/editing/deleting a man-day auto-refreshes the single labour Actual
  // Cost entry (Σ consumed md × day-rate) so AC stays in sync with timesheets without a
  // manual "Fill AC" click. Default off — labour AC stays manual (one-click fill).
  autoPostLabourAc Boolean @default(false)

  charter          ProjectCharter?
  charterVersions  CharterVersion[]
  baselineVersions BaselineVersion[]
  directCosts      CostItemDirect[]
  indirectCosts    CostItemIndirect[]
  risks            Risk[]
  issues           Issue[]
  tasks            Task[]
  costBaseline     CostBaseline?
  changeRequests   ChangeRequest[]
  attachments      Attachment[]
  actualCosts      ActualCostEntry[]
  sprints          Sprint[]
  backlogItems     BacklogItem[]
  mandayEntries    MandayEntry[]
  lessons          LessonLearned[]
  acceptances      AcceptanceSignoff[]
  stakeholders     Stakeholder[]
  procurements     Procurement[]
  assumptions      Assumption[]
  dependencies     ProjectDependency[]
  evmSnapshots     EvmSnapshot[]
  uatTestCases     UatTestCase[]
  kickoffMeeting   KickoffMeeting?
  bookmarks        ProjectBookmark[]
  requirements     Requirement[]
  commentaries     ProjectCommentary[]
  aiBriefings      AiBriefing[]
  approvalRequests ApprovalRequest[]
  aiActionProposals AiActionProposal[]
  aiActionOutcomes AiActionOutcome[]
  scheduleUndos    ScheduleUndo[]

  @@index([status])
  @@index([pmUserId])
  @@index([tenantId])
  @@unique([tenantId, code])
}

// Per-user project bookmark (personal "pin to top" flag). userId is stored FK-less
// (kept light, like closedById); the project relation cascades so a deleted project
// drops its bookmarks. One row per (user, project).
model ProjectBookmark {
  id        String   @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  userId    String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([tenantId])
}

model ProjectCharter {
  id              String          @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId       String          @unique
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  description     String
  goals           String
  category        ProjectCategory
  categoryOther   String?         // free-text detail, required only when category = OTHER
  hiScope         String
  hiCostIdr       Decimal         @db.Decimal(18, 2)
  hiScheduleStart DateTime
  hiScheduleEnd   DateTime
  hiDeliverables  String
  hiResources     String?         // high-level resources / key roles (narrative, optional)

  pmUserId        String
  pm              User            @relation("CharterPM", fields: [pmUserId], references: [id])

  version         Int             @default(1)
  locked          Boolean         @default(false)
  committedAt     DateTime?
  committedBy     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([category])
  @@index([tenantId])
}

// Immutable snapshot taken on each Commit (versioning + audit)
model CharterVersion {
  id          String   @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  committedBy String
  committedAt DateTime @default(now())

  @@unique([projectId, version])
  @@index([projectId])
  @@index([tenantId])
}

// A committed revision of the project's COMBINED baseline (schedule + cost), captured at each
// baseline LOCK (the commit event — see baseline.service applyBaselineLock). Re-baselining
// (unlock → change → re-lock) appends the next version, so B1/B2/B3… form an auditable history
// that the live single-snapshot stores (Task.baseline* + CostBaseline) do not retain. Snapshots
// are self-contained Json (task name/wbsCode captured too) so a comparison survives later renames
// /deletes. Mirrors CharterVersion. `committedAt` is the real commit time (for a backfilled v1 it's
// the historical lock date, not now).
model BaselineVersion {
  id          String   @id @default(uuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Int
  reason      String?  // why re-baselined (carried from the lock/unlock reason); null for the first
  committedBy String
  committedAt DateTime @default(now())
  schedule    Json     // [{ taskId, wbsCode, name, baselineStart, baselineFinish, weight }]
  cost        Json     // { directTotal, indirectTotal, contingencyReserve, managementReserve, costBaseline, budgetAtCompletion }

  @@unique([projectId, version])
  @@index([projectId])
  @@index([tenantId])
}

// =====================================================================
// COST MANAGEMENT (Module 2)
// =====================================================================

// Unified Direct Cost line (Material rows + Manpower rows), discriminated by `type`
model CostItemDirect {
  id        String         @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      DirectCostType
  label     String
  // Free-text classification for type = OTHER (e.g. "Insurance", "Legal"); null otherwise.
  subCategory String?
  // Manual display order within the cost list / its category family (drag-to-reorder in the UI).
  // New lines append (max+1); grouping by family is derived from `type`, order within by this.
  sortOrder Int @default(0)

  // --- Material fields (every non-MANPOWER type: TECHNOLOGY_*, HARDWARE_*, SOFTWARE_LICENSE, SUBCONTRACTOR, TRAINING_CERTIFICATION, SUPPORT_MAINTENANCE, OTHER) ---
  qty       Decimal?       @db.Decimal(18, 2)
  unitCost  Decimal?       @db.Decimal(18, 2)
  amount    Decimal?       @db.Decimal(18, 2) // = qty * unitCost

  // --- Manpower fields (type = MANPOWER) ---
  personnelRole     PersonnelRole?
  resourceUserId    String?
  resource          User?          @relation("ManpowerResource", fields: [resourceUserId], references: [id])
  rateCardId        String?
  rateCard          RateCard?      @relation(fields: [rateCardId], references: [id])
  unitCostPerManday Decimal?       @db.Decimal(18, 2)
  planMandays       Decimal?       @db.Decimal(10, 2)
  manpowerCost      Decimal?       @db.Decimal(18, 2) // = unitCostPerManday * planMandays

  // Link to schedule task (manpower <-> schedule sync)
  task   Task?   @relation("TaskManpower", fields: [taskId], references: [id])
  taskId String?

  // Link to the resource master (manpower pool). Preferred over the legacy
  // resourceUserId; supplies the day-rate and personnel role.
  resourceRef Resource? @relation("LineResource", fields: [resourceId], references: [id])
  resourceId  String?

  // Timesheet: actual man-days logged against this manpower line.
  mandayEntries MandayEntry[] @relation("LineTimesheet")

  // Actual spend attributed to THIS material line (per-component drawdown). Manpower lines
  // draw their actual from timesheets instead, so this is used for non-MANPOWER lines.
  actuals ActualCostEntry[] @relation("DirectLineActuals")

  // Contracts/POs charged to this budget line (committed cost — obligated but not necessarily paid).
  procurements Procurement[] @relation("ProcurementDirect")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, type])
  @@index([tenantId])
}

model CostItemIndirect {
  id          String           @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        IndirectCostType
  description String
  // Free-text classification for type = OTHER (e.g. "Insurance", "Bank charges"); null otherwise.
  subCategory String?
  amount      Decimal          @db.Decimal(18, 2)

  // Actual spend attributed to THIS indirect line (per-component drawdown).
  actuals ActualCostEntry[] @relation("IndirectLineActuals")

  // Contracts/POs charged to this budget line (committed cost).
  procurements Procurement[] @relation("ProcurementIndirect")

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([projectId, type])
  @@index([tenantId])
}

model RateCard {
  id                String           @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  roleName          String
  level             String?
  unitCostPerManday Decimal          @db.Decimal(18, 2)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // (A guest's rate cards are PRIVATE to their personal tenant; uniqueness of (roleName, level) is
  // enforced per-tenant in the service. The old `personalOwnerId` column was dropped in de-scatter.)
  directCosts CostItemDirect[]
  resources   Resource[]

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Resource master (manpower pool). A Resource is a person or a generic role
// available to projects; it is NOT a login account (optionally linked to one
// via userId). Picked when loading manpower into the WBS / Cost module.
// ---------------------------------------------------------------------------
enum ResourceType {
  NAMED // a specific person
  GENERIC // a role / placeholder (e.g. "Senior QA Engineer")
}

model Resource {
  id            String        @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  name          String
  resourceType  ResourceType  @default(NAMED)
  roleTitle     String? // free-text job title, e.g. "Backend Engineer"
  personnelRole PersonnelRole @default(PROJECT_PERSONNEL)

  // Costing: an effective day-rate, optionally sourced from a rate card.
  rateCardId        String?
  rateCard          RateCard? @relation(fields: [rateCardId], references: [id])
  unitCostPerManday Decimal   @default(0) @db.Decimal(18, 2)

  // Capacity: mandays available per working day (0.5 = half-time, 3 = a crew of 3).
  capacityPerDay Decimal @default(1) @db.Decimal(6, 2)

  department String?

  // (A guest's resources are PRIVATE to their personal tenant; the old `personalOwnerId` column was
  // dropped in de-scatter — tenant scoping isolates them.)
  // Optional link to a system account (for resources who also log in).
  userId String?
  user   User?   @relation("ResourceUser", fields: [userId], references: [id])

  costLines CostItemDirect[] @relation("LineResource")
  picTasks  Task[]           @relation("TaskPicResource")
  ownerOf   TaskOwner[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([tenantId])
}

// Computed roll-up cache (1:1 with Project)
model CostBaseline {
  id                 String   @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId          String   @unique
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  directTotal        Decimal  @default(0) @db.Decimal(18, 2)
  indirectTotal      Decimal  @default(0) @db.Decimal(18, 2)
  contingencyReserve Decimal  @default(0) @db.Decimal(18, 2)
  managementReserve  Decimal  @default(0) @db.Decimal(18, 2)
  costBaseline       Decimal  @default(0) @db.Decimal(18, 2) // direct + indirect + contingency
  budgetAtCompletion Decimal  @default(0) @db.Decimal(18, 2) // costBaseline + managementReserve

  updatedAt          DateTime @updatedAt
  @@index([tenantId])
}

// Time-phased Actual Cost (AC) entries — cumulative AC up to a status date
// drives the Cost Performance Index (CPI) in EVM.
model ActualCostEntry {
  id          String   @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date        DateTime
  amount      Decimal  @db.Decimal(18, 2)
  description String?
  // Which budget this spend draws down (direct vs indirect). Defaults to DIRECT:
  // existing rows + labour-from-timesheet are direct; the AC form can set INDIRECT.
  category    CostCategory @default(DIRECT)

  // Optional attribution to a specific budget line (per-component remaining). At most one is
  // set; both null = an "unattributed" entry that rolls up to its category bucket (legacy
  // behaviour). SetNull so deleting a budget line keeps the recorded spend (becomes general).
  directLineId   String?
  directLine     CostItemDirect?   @relation("DirectLineActuals",   fields: [directLineId],   references: [id], onDelete: SetNull)
  indirectLineId String?
  indirectLine   CostItemIndirect? @relation("IndirectLineActuals", fields: [indirectLineId], references: [id], onDelete: SetNull)

  recordedBy  String?
  createdAt   DateTime @default(now())

  @@index([projectId, date])
  @@index([directLineId])
  @@index([indirectLineId])
  @@index([tenantId])
}

// Timesheet: actual man-days consumed, logged against a MANPOWER cost line
// (which carries the resource + task + project). Time-phased like ActualCostEntry.
// Consumed effort per resource = Σ mandays over that resource's lines.
model MandayEntry {
  id         String         @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costItemId String
  costItem   CostItemDirect @relation("LineTimesheet", fields: [costItemId], references: [id], onDelete: Cascade)
  date       DateTime
  mandays    Decimal        @db.Decimal(10, 2)
  note       String?
  recordedBy String?
  createdAt  DateTime       @default(now())

  @@index([projectId, date])
  @@index([costItemId])
  @@index([tenantId])
}

// =====================================================================
// RISK MANAGEMENT (Module 3)
// =====================================================================

model Risk {
  id          String     @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String
  title       String
  description String?
  category    String?
  status      RiskStatus @default(IDENTIFIED)
  kind        RiskKind   @default(THREAT)

  ownerUserId String?
  owner       User?      @relation("RiskOwner", fields: [ownerUserId], references: [id])

  // --- Qualitative ---
  probabilityScore Int          // 1..5
  impactScore      Int          // 1..5
  riskScore        Int          // = probabilityScore * impactScore
  severity         RiskSeverity

  // --- Quantitative (EMV) ---
  probabilityPct Decimal  @db.Decimal(5, 4) // 0..1
  impactCostIdr  Decimal  @db.Decimal(18, 2)
  emv            Decimal  @db.Decimal(18, 2) // = probabilityPct * impactCostIdr

  // --- Response ---
  responseStrategy ResponseStrategy?
  responseCost     Decimal?          @db.Decimal(18, 2)
  residualEmv      Decimal?          @db.Decimal(18, 2)
  includeInReserve Boolean           @default(true)

  attachments Attachment[] @relation("RiskAttachments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, code])
  @@index([projectId, severity])
  @@index([tenantId])
}

// PM narrative for a status report — the story behind the numbers (highlights / lowlights /
// next-period focus) that the EVM KPIs can't tell. One row per project per reporting bucket
// (period + periodKey), so viewing an older report shows the commentary written for THAT period,
// not the latest. Written by the PM/PMO; surfaced on the Project report + PDF. Tenant-scoped
// (see lib/tenant/scopedModels.ts) — the extension stamps/filters tenantId automatically.
model ProjectCommentary {
  id        String  @id @default(uuid())
  tenantId  String?
  tenant    Tenant? @relation(fields: [tenantId], references: [id])
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Reporting bucket this narrative belongs to. period = daily|weekly|monthly|yearly; periodKey is
  // the normalized bucket start (daily/weekly=YYYY-MM-DD, monthly=YYYY-MM, yearly=YYYY).
  period    String
  periodKey String

  highlights String? // what went well / achievements this period
  lowlights  String? // challenges, blockers, concerns
  nextFocus  String? // planned focus / priorities for the next period

  // Denormalized author identity (no FK to User — a status report keeps its author's name even if
  // the account is later removed).
  authorId   String?
  authorName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, period, periodKey])
  @@index([tenantId])
}

// Proactive AI briefing — a PENDING, AI-DRAFTED status narrative (+ predictive slip/overrun flags)
// produced by the scheduled weekly sweep. NOT published: a PM reviews it, then Apply (→ writes a
// ProjectCommentary) or Dismiss. Kept separate from ProjectCommentary so the sweep never overwrites
// a human's saved narrative. One row per project per reporting period.
enum AiBriefingStatus {
  PENDING
  APPLIED
  DISMISSED
}

model AiBriefing {
  id        String  @id @default(uuid())
  tenantId  String?
  tenant    Tenant? @relation(fields: [tenantId], references: [id])
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Same reporting bucket as ProjectCommentary (period=weekly|…; periodKey normalized start).
  period    String
  periodKey String

  status    AiBriefingStatus @default(PENDING)

  // The AI draft (mirrors NarrativeDraft: executive summary + the three commentary fields).
  execSummary String? @db.Text
  highlights  String? @db.Text
  lowlights   String? @db.Text
  nextFocus   String? @db.Text

  // Deterministic predictive snapshot captured at sweep time (slip/overrun level + score), so the
  // briefing shows the risk picture without a re-compute. LOW/MED/HIGH + 0..100.
  slipLevel     String?
  slipScore     Int?
  overrunLevel  String?
  overrunScore  Int?

  model       String? // which AI model drafted it (audit / cost visibility)
  generatedAt DateTime @default(now())

  // Review trail (denormalized, no FK — mirrors ProjectCommentary's author fields).
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, period, periodKey])
  @@index([tenantId])
  @@index([projectId, status])
}

enum AiMemoryScope {
  USER   // personal to one user (userId set)
  TENANT // shared org-wide
}

enum AiMemoryKind {
  PREFERENCE // how the user likes answers (tone, length, format)
  FACT       // a durable fact about the user/org
  GLOSSARY   // a term → meaning mapping
  GUIDANCE   // a correction/rule distilled from 👎 feedback
}

enum AiMemorySource {
  EXPLICIT // user told Anett to remember (remember tool / Settings)
  FEEDBACK // spawned from a 👎 feedback note
  AUTO     // auto-distilled at conversation end (reserved — Fase 4)
}

/// Durable cross-session memory Anett injects into its prompt (dormant unless Tenant.aiMemoryEnabled).
/// scope=USER → personal (userId set); scope=TENANT → shared org-wide. GUIDANCE items come from 👎
/// feedback corrections. Tenant-scoped (register in scopedModels) so tenant hard-delete cascades.
model AiMemory {
  id       String  @id @default(uuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  scope   AiMemoryScope
  userId  String?        // set when scope=USER (denormalized, no FK — mirrors other AI author fields)
  kind    AiMemoryKind   @default(FACT)
  content String         @db.Text
  source  AiMemorySource @default(EXPLICIT)
  sourceRef String?      // audit — e.g. the AiFeedback id that spawned a GUIDANCE memory

  pinned Boolean @default(false) // user-pinned → sorted first, always kept in the prompt window
  active Boolean @default(true)  // soft-delete / "forget"

  createdById   String?
  createdByName String?
  useCount   Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, scope, userId, active])
}

enum AiFeedbackRating {
  UP
  DOWN
}

/// A 👍/👎 on an Anett answer. Deterministic learning: a 👎 with a note spawns a GUIDANCE AiMemory
/// (TENANT if the rater may write org-scope, else USER) that later prompts honor. Tenant-scoped.
model AiFeedback {
  id       String  @id @default(uuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  userId    String
  rating    AiFeedbackRating
  question  String? @db.Text // the user's question that produced the answer (bounded)
  answer    String  @db.Text // the assistant answer being rated (bounded)
  note      String? @db.Text // 👎 correction / what should have happened
  projectId String?          // context if the turn was about a project (denormalized, no FK)
  memoryId  String?          // the GUIDANCE memory spawned from this 👎, if any

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, rating, createdAt])
}

enum IssueImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Issue Log — problems that have already occurred (distinct from Risk, which is
// a potential future event). Lightweight register: no EVM/reserve impact.
model Issue {
  id          String      @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String
  title       String
  description String?
  category    String?
  impact      IssueImpact @default(MEDIUM)
  status      IssueStatus @default(OPEN)

  ownerUserId String?
  owner       User?       @relation("IssueOwner", fields: [ownerUserId], references: [id])

  resolution  String?     @db.Text
  raisedAt    DateTime    @default(now()) // when the issue was logged/occurred
  resolvedAt  DateTime?                   // auto-stamped when status → RESOLVED/CLOSED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, code])
  @@index([projectId, status])
  @@index([tenantId])
}

// =====================================================================
// STAKEHOLDER MANAGEMENT (PMBOK Stakeholder KA)
// =====================================================================

enum StakeholderCategory {
  SPONSOR
  CUSTOMER
  TEAM
  VENDOR
  REGULATOR
  END_USER
  OTHER
}

// Power & interest for the power/interest grid.
enum InfluenceLevel {
  LOW
  MEDIUM
  HIGH
}

// PMBOK engagement assessment matrix (ordered UNAWARE < RESISTANT < NEUTRAL <
// SUPPORTIVE < LEADING) — captured as current vs desired to surface the gap.
enum EngagementLevel {
  UNAWARE
  RESISTANT
  NEUTRAL
  SUPPORTIVE
  LEADING
}

// Stakeholder register — who has a stake, their power/interest, and the current
// vs desired engagement so the PM can plan engagement effort where the gap is.
model Stakeholder {
  id                String              @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId         String
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code              String
  name              String
  role              String? // title / role, e.g. "IT Director"
  organization      String?
  category          StakeholderCategory @default(OTHER)
  power             InfluenceLevel      @default(MEDIUM)
  interest          InfluenceLevel      @default(MEDIUM)
  currentEngagement EngagementLevel     @default(NEUTRAL)
  desiredEngagement EngagementLevel     @default(SUPPORTIVE)
  email             String?
  strategy          String?             @db.Text // engagement / communication approach
  notes             String?             @db.Text

  createdById String? // FK-less (kept light, like closeout artifacts)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, code])
  @@index([projectId])
  @@index([tenantId])
}

// =====================================================================
// PROCUREMENT MANAGEMENT (PMBOK Procurement KA)
// =====================================================================

enum ContractType {
  FIXED_PRICE
  TIME_AND_MATERIALS
  COST_PLUS
  PURCHASE_ORDER
}

enum ProcurementStatus {
  PLANNED
  SOLICITATION
  AWARDED
  IN_PROGRESS
  DELIVERED
  CLOSED
  CANCELLED
}

// Procurement / contract register — planned buys, vendors, contract type, value
// and status through the make-or-buy → solicit → award → deliver → close lifecycle.
model Procurement {
  id            String            @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code          String
  title         String
  vendor        String?
  vendorContact String?
  type          ContractType      @default(PURCHASE_ORDER)
  status        ProcurementStatus @default(PLANNED)
  amount        Decimal?          @db.Decimal(18, 2) // contract value (IDR)
  needBy        DateTime?
  startDate     DateTime?
  endDate       DateTime?
  scope         String?           @db.Text // SOW / what is procured
  notes         String?           @db.Text

  // Committed-cost link: charge this contract/PO to ONE budget line (direct XOR indirect), so the
  // Cost tab can show Budget → Committed → Actual → Remaining. Optional; SetNull if the line is deleted.
  costDirectLineId   String?
  costDirectLine     CostItemDirect?   @relation("ProcurementDirect", fields: [costDirectLineId], references: [id], onDelete: SetNull)
  costIndirectLineId String?
  costIndirectLine   CostItemIndirect? @relation("ProcurementIndirect", fields: [costIndirectLineId], references: [id], onDelete: SetNull)

  createdById String? // FK-less (kept light)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, code])
  @@index([projectId, status])
  // These FK indexes already exist in the DB (created by the procurement_cost_link migration);
  // declared here so the schema matches reality and migrate dev stops trying to drop them.
  @@index([costDirectLineId])
  @@index([costIndirectLineId])
  @@index([tenantId])
}

// =====================================================================
// RAID — Assumptions & Dependencies (completes RAID with Risk + Issue)
// =====================================================================

enum AssumptionStatus {
  OPEN
  VALIDATED
  INVALIDATED
}

// Assumption register — things taken as true for planning; each gets validated
// or invalidated over time (an invalidated assumption often becomes a risk/issue).
model Assumption {
  id          String           @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String
  statement   String           @db.Text
  category    String?
  status      AssumptionStatus @default(OPEN)
  impact      IssueImpact      @default(MEDIUM) // impact if it proves false
  ownerUserId String?
  owner       User?            @relation("AssumptionOwner", fields: [ownerUserId], references: [id])
  notes       String?          @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, code])
  @@index([projectId, status])
  @@index([tenantId])
}

// Direction of a cross-team / external dependency.
enum DependencyDirection {
  INBOUND // we need something from someone else
  OUTBOUND // someone else needs something from us
}

enum DependencyStatus {
  PENDING
  ON_TRACK
  AT_RISK
  RESOLVED
}

// Project-level dependency register (RAID "D") — external/cross-team dependencies,
// distinct from TaskDependency (the intra-schedule FS/SS/FF/SF links used by CPM).
model ProjectDependency {
  id           String              @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId    String
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code         String
  description  String              @db.Text
  direction    DependencyDirection @default(INBOUND)
  counterparty String? // the other team / project / vendor
  dueDate      DateTime?
  status       DependencyStatus    @default(PENDING)
  impact       IssueImpact         @default(MEDIUM) // criticality
  ownerUserId  String?
  owner        User?               @relation("DependencyOwner", fields: [ownerUserId], references: [id])
  notes        String?             @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, code])
  @@index([projectId, status])
  @@index([tenantId])
}

// =====================================================================
// SCHEDULE MANAGEMENT (Module 4)
// =====================================================================

model Task {
  id           String    @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentTaskId String?
  parent       Task?     @relation("TaskTree", fields: [parentTaskId], references: [id])
  subtasks     Task[]    @relation("TaskTree")

  wbsCode      String
  name         String
  // WBS dictionary — descriptive detail for each work package.
  description        String? @db.Text
  deliverable        String? @db.Text
  acceptanceCriteria String? @db.Text
  planStart    DateTime
  planEnd      DateTime
  // Schedule baseline snapshot (for variance / tracking Gantt).
  baselineStart  DateTime?
  baselineFinish DateTime?
  actualStart  DateTime?
  actualFinish DateTime?

  picUserId    String?
  pic          User?     @relation("TaskPIC", fields: [picUserId], references: [id])

  // Owner / person-in-charge picked from the resource master (preferred over picUserId).
  // picResourceId = the LEAD owner; it MUST also appear in `owners`. `owners` (TaskOwner join)
  // is the full set of assigned resources (lead + co-owners). Single-owner consumers use the lead.
  picResourceId String?
  picResource   Resource?   @relation("TaskPicResource", fields: [picResourceId], references: [id])
  owners        TaskOwner[]

  progressPct  Int       @default(0) // 0..100
  // Manual relative work-package weight (Model B). null = derive from cost/duration proxy.
  // Set on a Main Task to steer the top-down % roll-up; distributed to its leaves pro-rata.
  weight       Float?
  // PMB snapshot of `weight`, frozen when the schedule baseline is captured (like
  // baselineStart/Finish). EVM measures against THIS so re-planning weights can't silently
  // re-base EV/% complete. Re-captured on re-baseline. null until first baseline.
  baselineWeight Float?
  isMilestone  Boolean   @default(false)
  sortOrder    Int       @default(0)

  // schedule <-> cost (manpower) link
  manpowerItems CostItemDirect[] @relation("TaskManpower")

  // dependencies
  predecessorOf TaskDependency[] @relation("DepPredecessor")
  successorOf   TaskDependency[] @relation("DepSuccessor")

  // requirements traceability (which requirements this work delivers)
  requirementLinks RequirementTaskLink[]

  // Weighted progress steps (Model B, P6-style): when present, progressPct is DERIVED from the
  // completed steps' weights rather than entered by hand. See TaskStep.
  steps TaskStep[] @relation("TaskSteps")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, parentTaskId])
  @@index([tenantId])
}

// Join: a task's assigned owners (person-in-charge). Supports MULTIPLE owners per task; the
// LEAD owner is still `Task.picResourceId` (which also has a row here). Deleting either side
// cascades. Backfilled from the pre-existing single `picResourceId` at migration time.
model TaskOwner {
  taskId     String
  resourceId String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([taskId, resourceId])
  @@index([resourceId])
}

// A weighted progress step ("milestone"/deliverable) inside a work package. A task's % complete
// is DERIVED from Σ(done step weights) / Σ(step weights) — the P6 "weighted steps" technique — so
// progress is measured objectively against completed sub-deliverables instead of a subjective %.
model TaskStep {
  id        String   @id @default(uuid())
  // Nullable + nullable relation to match the other scoped models (Phase 2a): the tenant-scope
  // extension stamps tenantId on create at runtime.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation("TaskSteps", fields: [taskId], references: [id], onDelete: Cascade)
  name      String
  weight    Float    @default(1) // relative weight within the work package (>= 0)
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([tenantId])
}

model TaskDependency {
  id            String         @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  predecessorId String
  predecessor   Task           @relation("DepPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId   String
  successor     Task           @relation("DepSuccessor", fields: [successorId], references: [id], onDelete: Cascade)
  type          DependencyType @default(FS)
  lagDays       Int            @default(0)

  @@unique([predecessorId, successorId])
  @@index([tenantId])
}

// Bounded per-project undo stack for the WBS bulk-cleanup ops (bulk delete / clear). Each entry
// captures exactly what the op removed (tasks + their dependencies, owners, steps, requirement
// links, and the cost-line links it unlinked) so Undo can recreate it, plus the expanded id set so
// Redo can re-delete it. `sigBefore`/`sigAfter` fingerprint the schedule around the op so the stack
// self-invalidates when anything else changes it. Transient — safe to prune. See schedule.service.
model ScheduleUndo {
  id          String   @id @default(uuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seq         Int
  kind        String   // BULK_DELETE | CLEAR
  label       String
  ids         String[] // the expanded task ids the op deleted (roots + subtrees) — for redo
  removedJson Json     // { tasks, deps, owners, steps, reqLinks, costLinks } captured before delete
  sigBefore   String
  sigAfter    String
  undone      Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([projectId, seq])
  @@index([tenantId])
}

// =====================================================================
// GOVERNANCE: CHANGE CONTROL, AUDIT, ATTACHMENTS
// =====================================================================

model ChangeRequest {
  id          String              @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String // e.g. CHARTER, COST_BASELINE, SCHEDULE, SCOPE
  title       String
  description String

  chargeable  Boolean             @default(false) // paid (billable) vs no-cost change
  amountIdr   Decimal?            @db.Decimal(18, 2) // billable amount (only when chargeable)
  magnitude   ChangeMagnitude     @default(MINOR)
  impactAreas ChangeImpact[]      // areas affected: cost/schedule/resource/quality/risk

  status      ChangeRequestStatus @default(SUBMITTED)
  requestedBy String
  requester   User                @relation("CRRequester", fields: [requestedBy], references: [id])
  reviewedBy  String?
  reviewer    User?               @relation("CRReviewer", fields: [reviewedBy], references: [id])
  reviewedAt  DateTime?
  decidedBy   String?
  decider     User?               @relation("CRDecider", fields: [decidedBy], references: [id])
  decidedAt   DateTime?

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([projectId, status])
  @@index([tenantId])
}

// =====================================================================
// APPROVAL WORKFLOWS — admin-configured, multi-step approval routing.
// Phase 1 routes Change Requests; appliesTo is an enum so more entity
// kinds (cost baseline, closure) can be added later without a reshape.
// =====================================================================

enum ApprovalAppliesTo {
  CHANGE_REQUEST
  COST_BASELINE   // committing/locking the cost baseline (the PMB/BAC)
  BASELINE_UNLOCK // re-opening a locked baseline (the riskier, gated change-control action)
  PROJECT_CLOSURE // moving a project to CLOSED (wired in Phase 2b)
  AI_ACTION       // Stage C: an AI-proposed write (risk/progress/CR/tidy) awaiting human approval
}

enum ApprovalStepMode {
  ANY // one approver in the step is enough to clear it
  ALL // every approver in the step must approve
}

enum ApprovalApproverKind {
  ROLE       // every ACTIVE member holding `role` in the tenant
  USER       // one specific user
  PROJECT_PM // the PM of the entity's project (Project.pmUserId), resolved at runtime
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecisionKind {
  APPROVED
  REJECTED
}

// A reusable, admin-defined approval chain. Matched to an entity by `appliesTo` + optional
// conditions; a match routes the entity through the ordered steps instead of the legacy
// single-decider path. Tenant-scoped (see scopedModels.ts).
model ApprovalWorkflow {
  id               String            @id @default(uuid())
  tenantId         String?
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  appliesTo        ApprovalAppliesTo @default(CHANGE_REQUEST)
  enabled          Boolean           @default(true)
  // Optional matching conditions — every one that is set must hold; NULL means "any".
  condMagnitude    ChangeMagnitude?  // only CRs of this magnitude
  condChargeable   Boolean?          // only chargeable (true) / only non-chargeable (false)
  condMinAmountIdr Decimal?          @db.Decimal(18, 2) // only when amountIdr >= this
  // Optional escalation target: who to notify when a step blows its SLA. Null → the tenant's ADMINs.
  escalationUserId String?           // FK-less user id, like createdById
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  steps            ApprovalStep[]
  requests         ApprovalRequest[]

  @@index([tenantId])
}

model ApprovalStep {
  id         String                 @id @default(uuid())
  workflowId String
  workflow   ApprovalWorkflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order      Int                    // 1-based position in the chain
  name       String
  mode       ApprovalStepMode       @default(ANY)
  slaHours   Int?                   // optional deadline: escalate if the step is unresolved this long after it starts
  approvers  ApprovalStepApprover[]

  @@index([workflowId])
}

model ApprovalStepApprover {
  id     String               @id @default(uuid())
  stepId String
  step   ApprovalStep         @relation(fields: [stepId], references: [id], onDelete: Cascade)
  kind   ApprovalApproverKind
  role   Role?                // when kind = ROLE
  userId String?              // when kind = USER (FK-less id, like AutomationRule.createdById)

  @@index([stepId])
}

// A runtime instance: one entity travelling through one workflow. Tenant-scoped so the approver
// inbox and every read is auto-filtered to the active tenant by the Prisma extension.
model ApprovalRequest {
  id           String                @id @default(uuid())
  tenantId     String?
  tenant       Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowId   String
  workflow     ApprovalWorkflow      @relation(fields: [workflowId], references: [id])
  entityType   ApprovalAppliesTo     // what kind of entity is under approval
  entityId     String                // the target id (a ChangeRequest id, or the projectId for baseline/closure)
  // Parameters of the pending action, applied verbatim on final approval (e.g. the baseline-lock
  // reason, or the closure note/forceClose flag). Null for Change Requests (the CR row holds its own).
  payload      Json?
  projectId    String
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       ApprovalRequestStatus @default(PENDING)
  currentOrder Int                   @default(1) // the step order currently awaiting decisions
  dueAt        DateTime?             // deadline for the current step (from its slaHours); null = no SLA
  escalatedAt  DateTime?             // set once the current step has been escalated (so it fires only once)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  decisions    ApprovalDecision[]

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([projectId])
  @@index([status, dueAt])
}

// Stage C — a concrete, whitelisted action the AI has DRAFTED for a project, awaiting human
// approval before it executes. The proposal is routed through the existing approval engine as an
// AI_ACTION entity (ApprovalRequest.entityId = this row's id); on final APPROVE the executor runs
// the real, audited write (createRisk / setTaskProgress / createChangeRequest / applyAutoSchedule)
// with the APPROVER as actor — the AI never writes. Tenant-scoped (see scopedModels.ts).
model AiActionProposal {
  id           String            @id @default(uuid())
  tenantId     String?
  tenant       Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actionType   String            // registry key: CREATE_RISK | UPDATE_TASK_PROGRESS | CREATE_CHANGE_REQUEST | TIDY_SCHEDULE
  params       Json              // validated action parameters, replayed verbatim by the executor
  rationale    String?           // the AI's short justification (advisory, shown to the approver)
  confidence   String?           // LOW | MEDIUM | HIGH (self-reported; advisory only)
  status       AiActionStatus    @default(PENDING)
  proposedById String?           // the user in whose session the AI staged this (FK-less id)
  failureNote  String?           // set when execution threw on approval (status = FAILED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  appliedAt    DateTime?
  outcome      AiActionOutcome?

  @@index([tenantId])
  @@index([projectId])
  @@index([status])
}

enum AiActionStatus {
  PENDING  // drafted, routed for approval
  APPLIED  // approved and executed successfully
  REJECTED // an approver declined it
  FAILED   // approved but the executor threw (no effect applied)
}

// Outcome learning — closes the Stage C loop. When an AiActionProposal is APPLIED we stamp a
// baseline (SPI/CPI/progress at apply time), wait a fixed horizon (AI_OUTCOME_HORIZON_DAYS, ~21d),
// re-measure, and classify whether the action's target metric moved. Aggregated per actionType this
// becomes an evidence-backed track record Anett can cite ("helped 3 of the last 4 times").
// Deterministic (no LLM); correlational, NOT causal — labelled as such wherever it surfaces.
// Only metric-moving actions are scored (TIDY_SCHEDULE, UPDATE_TASK_PROGRESS → SPI); risk/CR are
// recorded as ADVISORY context only.
model AiActionOutcome {
  id             String           @id @default(uuid())
  tenantId       String?
  tenant         Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposalId     String           @unique
  proposal       AiActionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  actionType     String
  scored         Boolean          @default(false) // false = ADVISORY (not metric-scored)
  appliedAt      DateTime
  evalDueAt      DateTime         // appliedAt + horizon; measurement is due once this passes
  spiBefore      Float?
  cpiBefore      Float?
  progressBefore Float?
  spiAfter       Float?
  cpiAfter       Float?
  progressAfter  Float?
  spiDelta       Float?           // spiAfter - spiBefore (denormalized for cheap aggregation)
  measuredAt     DateTime?
  verdict        AiOutcomeVerdict @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([tenantId])
  @@index([projectId])
  @@index([actionType])
  @@index([verdict])
}

enum AiOutcomeVerdict {
  PENDING      // horizon not yet elapsed — awaiting measurement
  IMPROVED     // target metric rose beyond the threshold
  UNCHANGED    // within the noise threshold
  WORSENED     // target metric fell beyond the threshold
  INCONCLUSIVE // insufficient data to measure (e.g. no schedule/PV signal)
  ADVISORY     // action type not metric-scored (risk/CR) — context recorded only
}

model ApprovalDecision {
  id         String               @id @default(uuid())
  requestId  String
  request    ApprovalRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepId     String               // the ApprovalStep this decision was cast on
  stepOrder  Int                  // denormalized for per-step evaluation without a join
  approverId String               // the deciding user (FK-less id)
  decision   ApprovalDecisionKind
  comment    String?
  decidedAt  DateTime             @default(now())

  @@index([requestId])
}

// "While I'm away, X may approve on my behalf." An active (unexpired) delegation makes `toUser` an
// eligible approver anywhere `fromUser` is. Tenant-scoped; user ids are FK-less (like the approvers).
model ApprovalDelegation {
  id         String    @id @default(uuid())
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromUserId String    // the delegating approver
  toUserId   String    // who may act on their behalf
  note       String?
  expiresAt  DateTime? // null = until revoked
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([fromUserId])
}

model AuditLog {
  id        String   @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  projectId String? // set for project-scoped events (enables per-project audit view)
  entity    String
  entityId  String
  action    String // CREATE | UPDATE | DELETE | COMMIT | APPROVE | REJECT
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([projectId, createdAt])
  @@index([createdAt])
  @@index([tenantId])
}

model Attachment {
  id         String          @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  ownerType  AttachmentOwner
  ownerId    String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedBy String
  createdAt  DateTime        @default(now())

  // optional typed back-relations (kept loose/polymorphic by ownerType)
  project    Project? @relation(fields: [projectRelId], references: [id])
  projectRelId String?
  risk       Risk?    @relation("RiskAttachments", fields: [riskRelId], references: [id])
  riskRelId  String?

  @@index([ownerType, ownerId])
  @@index([tenantId])
}

// ---- Agile ----

// A time-boxed iteration (Scrum). Optional for Kanban projects (items can live in
// the product backlog / on the board without a sprint).
model Sprint {
  id        String       @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId String
  project   Project      @relation(fields: [projectId], references: [id])
  name      String
  goal      String?      @db.Text
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(PLANNED)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  items     BacklogItem[]
  snapshots SprintSnapshot[]

  @@index([projectId])
  @@index([tenantId])
}

// Daily snapshot of a sprint's remaining vs committed story points — powers the
// burndown chart (recorded when the board is fetched, deduped per day).
model SprintSnapshot {
  id               String   @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  sprintId         String
  sprint           Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  committedPoints  Int      @default(0)
  remainingPoints  Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([sprintId, date])
  @@index([sprintId])
  @@index([tenantId])
}

// A point-in-time capture of a project's EVM metrics. Progress (progressPct) is only
// a "now" value, so Earned Value cannot be reconstructed for past dates — capturing a
// snapshot freezes PV/EV/AC/CPI/SPI as-of a status date, turning the app's point-in-time
// EVM into a trend (the CPR/IPMR-style S-curve of EV & the CPI/SPI history over time).
// One snapshot per (project, statusDate); re-capturing the same date upserts.
model EvmSnapshot {
  id               String   @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  statusDate       DateTime @db.Date
  bac              Decimal  @db.Decimal(18, 2)
  pv               Decimal  @db.Decimal(18, 2)
  ev               Decimal  @db.Decimal(18, 2)
  ac               Decimal  @db.Decimal(18, 2)
  cpi              Float    @default(0)
  spi              Float    @default(0)
  weightedProgress Float    @default(0) // physical % complete (0..1) at the status date
  note             String?
  createdById      String?  // actor who captured it (plain id, no FK — kept light)
  createdAt        DateTime @default(now())

  @@unique([projectId, statusDate])
  @@index([projectId, statusDate])
  @@index([tenantId])
}

// Persistent per-user in-app notification (inbox) — for discrete events like being
// assigned as a project's PM (not the on-demand "needs attention" alerts).
model Notification {
  id        String    @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  userId    String
  user      User      @relation("UserNotifications", fields: [userId], references: [id])
  type      String    // e.g. PROJECT_ASSIGNED
  title     String
  body      String?   @db.Text
  projectId String?
  link      String?   // explicit deep-link path (overrides the type-derived link), e.g. a CR's target tab
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([tenantId])
}

// In-app product feedback (bug / idea / other) from any signed-in user, incl. sandbox guests.
// Tenant-scoped like Notification. Captured with the page/role/release context so a one-line
// report is actionable; admins triage it in the /admin/feedback inbox. See docs (feedback feature).
model Feedback {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation("UserFeedback", fields: [userId], references: [id])
  type      String   // BUG | IDEA | OTHER
  message   String   @db.Text
  pageUrl   String?
  role      String?
  release   String?
  userAgent String?  @db.Text
  status    String   @default("OPEN") // OPEN | REVIEWED | CLOSED
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([status])
  @@index([userId])
}

// Per-user "followed up / dismissed" markers for the LIVE "Needs attention" alerts (which are
// derived, not stored). Keyed by a SIGNATURE = hash(projectId|type|message); because the alert
// message encodes its magnitude (days overdue, Rp overrun, severity), a worsening alert produces a
// NEW signature → it re-appears (the dismissal only silences the exact state that was followed up).
// GLOBAL (no tenantId, NOT in SCOPED_MODELS): keyed by the global user identity; the signature
// already embeds projectId, so there is no cross-tenant ambiguity.
model AlertDismissal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserAlertDismissals", fields: [userId], references: [id], onDelete: Cascade)
  signature String
  createdAt DateTime @default(now())

  @@unique([userId, signature])
  @@index([userId])
}

// A private 1-to-1 direct-message thread between two users. Exactly one row per pair,
// enforced by storing the pair in canonical order (userAId < userBId string compare) with a
// unique constraint — so find-or-create is deterministic. `lastReadA/BAt` are each side's read
// cursor: a user's unread count = messages from the OTHER side newer than their own cursor.
enum ConversationType {
  DIRECT
  GROUP
}

model Conversation {
  id            String           @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  type          ConversationType @default(DIRECT)
  // DIRECT only: the canonical (userAId < userBId) pair — the dedup key so a 1-1 thread is unique.
  // NULL for GROUP conversations. lastReadA/BAt are legacy per-side cursors, superseded by
  // ConversationMember.lastReadAt (kept for the backfill source; not read anymore).
  userAId       String?
  userBId       String?
  userA         User?            @relation("ConvUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User?            @relation("ConvUserB", fields: [userBId], references: [id], onDelete: Cascade)
  lastReadAAt   DateTime?
  lastReadBAt   DateTime?
  // GROUP only: display title, optional linked project (plain id, no FK — like closedById), creator.
  title         String?
  projectId     String?
  createdById   String?
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  messages      Message[]
  members       ConversationMember[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
  @@index([tenantId])
}

// Membership + per-member read cursor for a conversation. Unifies DIRECT (2 members) and GROUP
// (N members): a member's unread = messages from OTHERS newer than their lastReadAt.
model ConversationMember {
  id             String       @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("ConvMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  isAdmin        Boolean      @default(false)
  // Per-user "delete conversation" = hide from my list; it reappears when a message arrives after
  // hiddenAt (or when I reopen/post). NULL = visible.
  hiddenAt       DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([tenantId])
}

// A single chat message within a Conversation.
model Message {
  id             String       @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String       @db.Text
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  // Optional single file attachment. storageKey is the multer-generated safe name in the shared
  // uploads/ dir (same storage as project Attachments, so it's covered by backups).
  attachmentKey  String?
  attachmentName String?
  attachmentMime String?
  attachmentSize Int?
  reactions      MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([tenantId])
}

// A browser Web-Push subscription (one per device/browser) for a user. endpoint is the push
// service URL (unique); p256dh + auth are the client's encryption keys.
model PushSubscription {
  id        String   @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
}

// An emoji reaction on a message. A user may add each distinct emoji once per message.
model MessageReaction {
  id        String   @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ReactionUser", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([tenantId])
}

// A product-backlog work item (epic/story/task/bug). `sprintId` null = product
// backlog; when in a sprint it shows on the board by `status`.
model BacklogItem {
  id                 String        @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId          String
  project            Project       @relation(fields: [projectId], references: [id])
  sprintId           String?
  sprint             Sprint?       @relation(fields: [sprintId], references: [id])
  type               BacklogType   @default(STORY)
  title              String
  description        String?       @db.Text
  acceptanceCriteria String?       @db.Text
  storyPoints        Int?
  priority           Int           @default(0) // MoSCoW-ish rank; lower = higher priority
  status             BacklogStatus @default(TODO)
  assigneeUserId     String?
  assignee           User?         @relation("BacklogAssignee", fields: [assigneeUserId], references: [id])
  sortOrder          Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([projectId])
  @@index([sprintId])
  @@index([tenantId])
}

// --- Closing artifacts (PMBOK Close-Project process) -------------------------
// Captured during/at project closeout: a lessons-learned register + formal
// deliverable acceptance sign-offs. Both surface as advisory items on the
// closure-readiness checklist (they never hard-block closure — only schedule
// completeness does, per the PMO policy).

enum LessonCategory {
  WENT_WELL      // what worked and should be repeated
  WENT_WRONG     // what to avoid next time
  RECOMMENDATION // an action/improvement for future projects
}

enum AcceptanceDecision {
  ACCEPTED
  ACCEPTED_WITH_CONDITIONS
  REJECTED
}

// A single entry in the project's lessons-learned register.
model LessonLearned {
  id          String         @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    LessonCategory @default(RECOMMENDATION)
  title       String
  description String?        @db.Text
  createdById String?        // actor who logged it (plain id, no FK — name resolved in the service)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projectId])
  @@index([tenantId])
}

// A formal acceptance sign-off from an accepting party (sponsor, customer, …).
// The signer may be external, so the name is free text; recordedById is the
// system user who logged the sign-off.
model AcceptanceSignoff {
  id           String             @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  party        String             // who accepts: e.g. "Sponsor", "Customer — Bank X"
  decision     AcceptanceDecision @default(ACCEPTED)
  signedByName String?            // named signer (may be external, not a system user)
  comments     String?            @db.Text
  recordedById String?            // system user who logged it (plain id, name resolved in the service)
  signedAt     DateTime           @default(now())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([projectId])
  @@index([tenantId])
}

// User Acceptance Test case — a structured, executable UAT template per project.
enum UatStatus {
  NOT_RUN
  PASS
  FAIL
  BLOCKED
}

model UatTestCase {
  id          String    @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code        String // per-project code, e.g. UAT-001
  title       String
  scenario    String?   @db.Text // context / preconditions (given)
  steps       String?   @db.Text // steps to execute (when)
  expected    String    @db.Text // expected result (then)
  actual      String?   @db.Text // actual result on execution
  status      UatStatus @default(NOT_RUN)
  testerName  String? // who ran it (free text; may be an external UAT tester)
  executedAt  DateTime?
  notes       String?   @db.Text // defect reference / remarks
  sortOrder   Int       @default(0)
  createdById String? // actor who created it (plain id, no FK — name resolved in the service)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId])
  @@index([tenantId])
}

// Kick-Off Meeting minutes — one structured record per project (Initiating artifact).
model KickoffMeeting {
  id          String              @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId   String              @unique
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  meetingDate DateTime?
  location    String? // e.g. "Online (Teams)" / "HQ Room 3A"
  facilitator String?
  agenda      String?             @db.Text
  objectives  String?             @db.Text
  decisions   String?             @db.Text
  notes       String?             @db.Text
  attendees   KickoffAttendee[]
  actionItems KickoffActionItem[]
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  @@index([tenantId])
}

model KickoffAttendee {
  id        String         @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  meetingId String
  meeting   KickoffMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name      String
  role      String? // role / organization
  present   Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([meetingId])
  @@index([tenantId])
}

enum KickoffActionStatus {
  OPEN
  DONE
}

model KickoffActionItem {
  id          String              @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  meetingId   String
  meeting     KickoffMeeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  description String              @db.Text
  ownerName   String?
  dueDate     DateTime?
  status      KickoffActionStatus @default(OPEN)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([meetingId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Requirements traceability (RTM) — a scope register linked to the WBS work
// that delivers each requirement, yielding a coverage matrix + scope-gap view.
// ---------------------------------------------------------------------------

enum RequirementCategory {
  FUNCTIONAL
  NON_FUNCTIONAL
  BUSINESS
  TECHNICAL
  REGULATORY
  OTHER
}

// MoSCoW prioritisation.
enum RequirementPriority {
  MUST
  SHOULD
  COULD
  WONT
}

enum RequirementStatus {
  PROPOSED
  APPROVED
  IN_PROGRESS
  VERIFIED
  DEFERRED
  REJECTED
}

model Requirement {
  id                 String              @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  projectId          String
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code               String // REQ-001, REQ-002, …
  title              String
  description        String?             @db.Text
  category           RequirementCategory @default(FUNCTIONAL)
  priority           RequirementPriority @default(MUST)
  status             RequirementStatus   @default(PROPOSED)
  source             String? // origin: stakeholder, document, charter clause…
  acceptanceCriteria String?             @db.Text
  notes              String?             @db.Text

  taskLinks RequirementTaskLink[]

  createdById String? // FK-less (kept light, like the other registers)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, code])
  @@index([projectId])
  @@index([tenantId])
}

// Forward traceability: requirement -> the WBS task(s) that deliver it.
model RequirementTaskLink {
  id            String      @id @default(uuid())
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([requirementId, taskId])
  @@index([requirementId])
  @@index([taskId])
  @@index([tenantId])
}

// Runtime-toggleable app settings — a single row (id="singleton"). Lets an ADMIN enable/disable
// the open sign-up paths (guest email+password signup, Google sign-in) from the UI without an
// env change + restart. Seeded from the env flags on first read so a deploy preserves behaviour.
model AppSetting {
  id                 String   @id @default("singleton")
  // Pooled-multitenancy scope (Phase 2). Nullable in 2a (expand+backfill);
  // flipped NOT NULL in 2b. See docs/MULTITENANCY-POOLED-PLAN.md.
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  guestSignupEnabled Boolean  @default(false)
  googleLoginEnabled Boolean  @default(false)
  // Self-serve ORGANIZATION signup (Phase 6 SaaS): anyone may create a new corporate tenant + its
  // owner. Deployment-level toggle (admin-editable), off by default.
  orgSignupEnabled   Boolean  @default(false)
  // Weekly EVM auto-capture (opt-in). Weekday: 0=Sun .. 6=Sat (default 1 = Monday).
  // lastRunAt is scheduler-managed so a restart doesn't re-run the same day.
  evmAutoCaptureEnabled   Boolean   @default(false)
  evmAutoCaptureWeekday   Int       @default(1)
  evmAutoCaptureLastRunAt DateTime?
  updatedById        String?
  updatedAt          DateTime @updatedAt
  @@index([tenantId])
  // One settings row per tenant (Phase 3c). The singleton id="singleton" PK stays for now (code
  // still reads by it); this makes the per-tenant scoping a real DB constraint.
  @@unique([tenantId])
}
