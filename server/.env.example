# PostgreSQL connection (Prisma)
DATABASE_URL="postgresql://prima:prima@localhost:5432/prima_pm?schema=public"

# Auth
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# App
PORT=4000
NODE_ENV=development

# Optional open-registration paths (both OFF unless set)
# GUEST_SIGNUP_ENABLED=true            # self-service guest signup (POST /auth/guest/register)
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com   # "Sign in with Google" → sandboxed GUEST
#   Create an OAuth 2.0 Web client in Google Cloud Console; add your site to Authorized
#   JavaScript origins (e.g. https://your-domain). The client ID is public (ships in the browser).

# Cloudflare Turnstile CAPTCHA on the public forms (guest signup, org signup, login).
# Enabled only when the SECRET key is set (server verifies via siteverify); the SITE key is public
# (renders the widget). Get both from the Cloudflare dashboard → Turnstile. Off ⇒ no CAPTCHA.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...secret

# Lemon Squeezy SaaS billing (merchant-of-record). Enabled only when BOTH the API key and the
# webhook secret are set; otherwise the /billing endpoints report 503 and the app is unchanged.
# Use a TEST store + test API key first (dashboard → Settings → API). Point the LS webhook at
# https://<your-domain>/webhooks/lemonsqueezy and subscribe to the subscription_* events.
# LEMONSQUEEZY_API_KEY=eyJ0eXAiOiJKV1Qi...            # store-scoped API key (Bearer)
# LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret
# LEMONSQUEEZY_STORE_ID=12345                          # numeric store id
# LEMONSQUEEZY_VARIANT_ID_PRO=67890                    # variant id sold as the PRO plan
# LEMONSQUEEZY_VARIANT_ID_ENTERPRISE=67891             # variant id sold as the ENTERPRISE plan

# --- AI Status Narrative (Claude-powered) --------------------------------------------------------
# Set ANTHROPIC_API_KEY to enable the "Draft dengan AI" feature in the Reporting Hub. Unset ⇒ the
# endpoint returns 503 and nothing else changes (dormant-by-default). A SECOND per-tenant opt-in
# (Tenant.aiNarrativeEnabled) must also be true — a tenant admin/super-admin enables it per workspace.
# ANTHROPIC_API_KEY=sk-ant-...                         # Anthropic API key
# AI_MODEL=claude-opus-4-8                             # optional model override (default claude-opus-4-8)
